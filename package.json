{
  "name": "etalonops-mrf-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "api": "tsx server/main.ts",
    "test:server": "tsx --test server/*.test.ts",
    "catalog": "tsx scripts/catalog.ts",
    "db:backup": "tsx scripts/backup.ts",
    "sql:prepare": "python scripts/sql-local.py && tsx scripts/sql-init.ts && tsx scripts/sql-init.ts --tests",
    "test:sql": "tsx --test server/sql.integration.ts",
    "test:browser:sql": "ETALONOPS_TEST_DB_ENGINE=sqlserver playwright test",
    "sql:recovery-check": "tsx scripts/sql-recovery-check.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "mssql": "^12.7.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
